+extern "C" int pdVisionVRActive(void);
+extern "C" unsigned int pdVisionVREye(int eye, float E[4][4], float tan[4], float depth[2]);
+extern "C" void pdVisionVRNoteWorldDepth(float p22, float p32);
+extern "C" void pdVisionVRNoteEyeMP(int eye, int cls, const float m[4][4]);
