# LEGAL: never game data. The ROM, the XBLA package/archive, and anything
# unpacked from them never enter this repo.
work/gamedata/
work/oracle/
*.z64
*.n64
*.v64
*.rar
*.7z
xbla/
# ...except the port's own evidence directory, which has the same name and holds
# only screenshots. The *.rar / *.7z / *.z64 rules above still apply inside it,
# so no archive can land here by accident.
!artifacts/sim/xbla/
# The visionOS gate's own copy of it, which the same rule swallowed for three
# rounds: the negation above is a path, not a basename, so the Vision Pro's
# XBLA stamps were never committed. Same contents, same guarantees.
!artifacts/sim/visionos/xbla/
cache/
*.ipa
*.dSYM/

# Machine-specific symlink to the ANGLE macOS slice in realrtcw-ios/work/angle
# (docs/angle-spike.md recreates it with one ln -sfn).
work/angle-mac

# Build + vendor trees
build/
build-*/
vendor/*/
DerivedData/
*.xcodeproj/
*.xcworkspace/

# OTA staging (IPAs live on the private server, never in git)
ota/**/*.ipa
ota/**/manifest-*.plist

# scratch
tmp/
.DS_Store
*.swp
compile_commands.json

# Oracle replay raw output (hundreds of MB of logs and full-size PNGs).
# The committed evidence is artifacts/oracle/baseline/ - downscaled shots plus
# the summary and checksums that scripts/replay-diff.sh produced.
artifacts/oracle/replay/

# Machine-specific symlinks to sibling-built dependencies. work/deps-PROVENANCE.md
# says exactly what each one points at and how to rebuild it from source.
work/angle-ios-device
work/angle-ios-simulator
work/angle-include
work/deps-iphoneos
work/deps-iphonesimulator
work/angle-xcframeworks

# Generated by scripts/gen-app-project.sh
app/project.generated.yml
app/ios/build_stamp.h

# Raw oracle/sim gate output: hundreds of thousands of lines, all reproducible.
# The committed evidence is artifacts/oracle/sim-gate/*.gfx.gz + the .ini.
work/sim-gate/*.gfx
work/sim-gate/*.log
work/sim-validate/

# visionOS (Phase 5): the same machine-specific symlinks and locally built deps.
# work/deps-PROVENANCE.md recreates all of them.
work/angle-visionos-device
work/angle-visionos-simulator
work/deps-xros
work/deps-xrsimulator
work/sdl2-visionos/
work/vision-validate/

# libcurl 8.11.0 slices (D-010): two-symlink trees into ~/dev/q2repro-ios/work.
# work/curl-PROVENANCE.md recreates all four and says what they are.
work/curl-iphoneos/
work/curl-iphonesimulator/
work/curl-xros/
work/curl-xrsimulator/

# Texture packs are the player's own assets (PD Plus HD is 180 MB) — never in
# the repo. work/texpacks-PROVENANCE.md says where they came from.
work/texpacks/

# gate scratch output (artifacts/ holds the kept evidence)
work/sim-validate/
work/vision-validate/

# Round-A scratch runs (the artifacts they produce live in artifacts/sim/round-a).
work/round-a/
work/round-a-vision/

# Phase 6 M3's verification scratch (scripts/vision3d-m3-verify.sh): four
# seeded replays' PNGs, gfx streams and console logs. Regenerable by re-running
# the script; what is worth keeping is copied into artifacts/sim/visionos-3d/m3/.
work/vision3d-m3/

# Phase 6 M2's verification scratch (scripts/vision3d-m2-verify.sh): five
# 2000-frame replay logs, their console captures and the intermediate PNGs.
# What is worth keeping is copied into artifacts/sim/visionos-3d/m2/.
work/vision3d-m2/
work/*-verify.log
work/*-verify-live.log
work/vgate-*.log
work/igate-*.log

# Phase 6 dev2-stereo verification scratch (scripts/vision3d-stereo-verify.sh):
# console and build logs plus the raw replay PNGs. The keepers are copied into
# artifacts/sim/visionos-3d/dev2-stereo/ by the script itself.
work/vision3d-dev2s/

# Phase 6 dev2-stereo round 2's glare-frame hunt: the seeded L/R pairs at
# frame 1295 and the pacing-engine-8 sweep that found it. Everything kept is
# copied into artifacts/sim/visionos-3d/dev2-stereo/glare/ by
# scripts/stereo-glare-check.py; this is the raw capture dir.
work/vision3d-glare/

# Release staging (the IPAs are the ones the hub serves; they are not tracked)
dist/

